---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<header class="phead wrap">
  {
    eyebrow && (
      <p class="eyebrow" data-reveal>
        <span class="dots" aria-hidden="true"><i /><i /><i /></span>
        {eyebrow}
      </p>
    )
  }
  <h1 data-reveal style="--d:1">{title}</h1>
  {lead && <p class="lead" data-reveal style="--d:2">{lead}</p>}
  <slot />
</header>

<style>
  .phead {
    padding-top: clamp(40px, 7vw, 96px);
    padding-bottom: clamp(32px, 5vw, 56px);
  }
  h1 {
    margin: 18px 0 20px;
    font-size: clamp(46px, 8vw, 96px);
    letter-spacing: -0.035em;
  }
</style>
