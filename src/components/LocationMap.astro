---
/**
 * Animasi lokasi studio: diorama mini Jawa Barat bergaya ilustrasi.
 * Pulau muncul dari laut → gunung, pohon, Monas → markas Overlight jatuh di Cibinong →
 * jalan tergambar dan mobil Bloop melaju dari Jakarta → pin & kartu lokasi.
 * Pin = kota markas studio (tetap), bukan lokasi seseorang saat ini. Peta ilustratif, bukan peta presisi.
 */
import type { Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const copy = {
  id: { city: "Cibinong, Bogor", region: "Jawa Barat, Indonesia", zone: "Zona waktu WIB (UTC+7)", open: "Buka di Google Maps", replay: "Putar ulang", here: "Markas Overlight" },
  en: { city: "Cibinong, Bogor", region: "West Java, Indonesia", zone: "Time zone WIB (UTC+7)", open: "Open in Google Maps", replay: "Replay", here: "Overlight HQ" },
}[lang];
const mapsUrl = "https://www.google.com/maps/search/?api=1&query=Cibinong%2C%20Bogor%2C%20Indonesia";

const ISLAND =
  "M70 262 C 62 208, 130 178, 205 186 C 262 160, 330 150, 400 165 C 470 160, 548 196, 548 248 C 552 300, 488 332, 410 326 C 340 344, 250 340, 180 328 C 110 330, 74 305, 70 262 Z";
const ROUTE = "M300 205 C 246 214, 244 238, 276 243 C 298 246, 292 258, 297 268";
const trees: [number, number, number, string][] = [
  [128, 252, 11, "#8fd19a"],
  [150, 282, 9, "#7cc48c"],
  [240, 212, 9, "#8fd19a"],
  [262, 300, 10, "#7cc48c"],
  [366, 300, 11, "#8fd19a"],
  [378, 206, 8, "#7cc48c"],
  [505, 246, 11, "#8fd19a"],
  [486, 288, 9, "#7cc48c"],
];
---

<div class="loc" data-loc>
  <a class="loc-map" href={mapsUrl} target="_blank" rel="noopener" aria-label={`${copy.city}, ${copy.region}. ${copy.open}`}>
    <svg viewBox="0 0 600 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true" data-svg>
      <defs>
        <linearGradient id="lm-sky" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#cfe6ff" />
          <stop offset="1" stop-color="#f3ecff" />
        </linearGradient>
        <linearGradient id="lm-sea" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#a9dcf5" />
          <stop offset="1" stop-color="#7fbfea" />
        </linearGradient>
        <linearGradient id="lm-grass" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#d4f0c6" />
          <stop offset="1" stop-color="#a7dba8" />
        </linearGradient>
        <linearGradient id="lm-mt1" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#7ec991" />
          <stop offset="1" stop-color="#4fa572" />
        </linearGradient>
        <linearGradient id="lm-mt2" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#93d3a6" />
          <stop offset="1" stop-color="#5fb381" />
        </linearGradient>
        <linearGradient id="lm-brand" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#74bcde" />
          <stop offset="0.5" stop-color="#7d55cc" />
          <stop offset="1" stop-color="#a660d8" />
        </linearGradient>
        <mask id="lm-route-mask">
          <path d={ROUTE} fill="none" stroke="#fff" stroke-width="10" stroke-linecap="round" data-route-reveal />
        </mask>
      </defs>

      <!-- langit & matahari -->
      <rect width="600" height="400" fill="url(#lm-sky)" />

      <g class="sun" transform="translate(72 64)">
        <g class="sun-rays" stroke="#ffc94d" stroke-width="4" stroke-linecap="round">
          <path d="M0 -40v-10M0 40v10M-40 0h-10M40 0h10M-28 -28l-7 -7M28 28l7 7M-28 28l-7 7M28 -28l7 -7" />
        </g>
        <circle r="24" fill="#ffd36e" />
        <circle r="24" fill="none" stroke="#ffbf3a" stroke-width="3" />
      </g>


      <!-- awan & burung -->
      <g class="cloud c1"><g fill="#fff"><ellipse cx="0" cy="0" rx="34" ry="13" /><ellipse cx="-14" cy="-9" rx="16" ry="12" /><ellipse cx="12" cy="-12" rx="18" ry="14" /></g></g>
      <g class="cloud c2"><g fill="#fff"><ellipse cx="0" cy="0" rx="26" ry="10" /><ellipse cx="-9" cy="-7" rx="12" ry="9" /><ellipse cx="9" cy="-9" rx="13" ry="10" /></g></g>
      <g class="cloud c3"><g fill="#fff"><ellipse cx="0" cy="0" rx="30" ry="11" /><ellipse cx="10" cy="-9" rx="15" ry="11" /></g></g>
      <g class="birds" stroke="#4a4566" stroke-width="1.8" fill="none" stroke-linecap="round">
        <path d="M0 0q5 -5 10 0q5 -5 10 0" />
        <path d="M24 10q4 -4 8 0q4 -4 8 0" />
      </g>

      <!-- laut berombak -->
      <rect class="sea" y="225" width="600" height="175" fill="url(#lm-sea)" />
      <g class="waves" stroke="#fff" stroke-width="2.2" fill="none" stroke-linecap="round" opacity="0.7">
        <path class="wave w1" d="M-60 250 q15 -6 30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0" />
        <path class="wave w2" d="M-60 352 q15 -6 30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0" />
        <path class="wave w3" d="M-60 382 q15 -6 30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0" />
      </g>
      <g class="boat-in" transform="translate(500 364)">
        <g class="boat">
          <path d="M-22 0h44l-8 10h-28z" fill="#6c86d6" />
          <path d="M0 -2v-30l18 26z" fill="url(#lm-brand)" />
          <path d="M-2 -4v-22l-13 20z" fill="#fff" />
        </g>
      </g>

      <!-- pulau -->
      <g class="island" data-island>
        <path d={ISLAND} fill="none" stroke="#fff0c9" stroke-width="18" stroke-linejoin="round" />
        <path d={ISLAND} fill="url(#lm-grass)" />
        <path d="M120 300 C 200 318, 300 322, 420 312" fill="none" stroke="#bfe5b6" stroke-width="3" stroke-linecap="round" opacity="0.8" />

        <!-- Gunung Salak (kiri) & Gede-Pangrango (kanan) -->
        <g class="mt" data-mt><path d="M148 318 Q 192 246 202 248 Q 214 246 256 318 Z" fill="url(#lm-mt1)" /><path d="M202 248 Q 196 268 186 286" fill="none" stroke="#c5ecd0" stroke-width="3" stroke-linecap="round" /></g>
        <g class="mt" data-mt><path d="M384 316 Q 432 238 442 240 Q 454 238 504 316 Z" fill="url(#lm-mt2)" /><path d="M442 240 Q 436 262 426 280" fill="none" stroke="#d4f2dc" stroke-width="3" stroke-linecap="round" /></g>

        <!-- pohon -->
        {
          trees.map(([x, y, r, c]) => (
            <g class="tree-in" data-tree transform={`translate(${x} ${y})`}>
              <g class="tree">
                <rect x="-1.8" y="0" width="3.6" height={r * 0.9} rx="1.5" fill="#8a6a4f" />
                <circle cy={-r * 0.25} r={r} fill={c} />
                <circle cx={-r * 0.35} cy={-r * 0.55} r={r * 0.35} fill="#fff" opacity="0.35" />
              </g>
            </g>
          ))
        }

        <!-- Monas -->
        <g class="monas" data-monas>
          <rect x="284" y="198" width="32" height="6" rx="2" fill="#e7e1f5" />
          <rect x="291" y="192" width="18" height="6" rx="2" fill="#f2eefb" />
          <path d="M296 192 L 298.4 158 L 301.6 158 L 304 192 Z" fill="#fbfaff" stroke="#cfc6e6" stroke-width="1.2" />
          <path class="flame" d="M300 146 C 305 151 305 156 300 158 C 295 156 295 151 300 146 Z" fill="#f5b700" />
        </g>

        <!-- jalan Jakarta → Cibinong -->
        <path d={ROUTE} fill="none" stroke="#fff6dd" stroke-width="7" stroke-linecap="round" mask="url(#lm-route-mask)" />
        <path d={ROUTE} fill="none" stroke="#e8b04a" stroke-width="1.6" stroke-dasharray="4 5" stroke-linecap="round" mask="url(#lm-route-mask)" data-route />

        <!-- markas Overlight: kotak logo + ekor, cerobong mengepul kotak-kotak -->
        <g class="hq-in" data-hq>
          <g class="hq">
            <g class="puffs" fill="none" stroke="#b9a7e6" stroke-width="2">
              <rect class="puff p1" x="327" y="226" width="7" height="7" rx="2" />
              <rect class="puff p2" x="327" y="226" width="7" height="7" rx="2" />
              <rect class="puff p3" x="327" y="226" width="7" height="7" rx="2" />
            </g>
            <rect x="327" y="232" width="7" height="13" rx="2" fill="#6c86d6" />
            <path d="M326 278 l7 9 l3 -9 z" fill="#a660d8" />
            <rect x="296" y="242" width="44" height="37" rx="11" fill="#fff" stroke="url(#lm-brand)" stroke-width="5" />
            <rect class="win" x="303" y="250" width="9" height="8" rx="2.5" fill="#cfe6ff" />
            <rect class="win" x="324" y="250" width="9" height="8" rx="2.5" fill="#cfe6ff" />
            <rect x="311" y="262" width="13" height="15" rx="3.5" fill="#7d55cc" />
            <circle cx="320.5" cy="270" r="1.2" fill="#fff" />
          </g>
        </g>

        <!-- riak & pin di atas markas -->
        <g class="ripples" transform="translate(318 282)">
          <ellipse rx="20" ry="7" /><ellipse rx="20" ry="7" />
        </g>
        <g class="pin-in" data-pin transform="translate(318 230)">
          <g class="pin">
            <path d="M-11 -34h22a7 7 0 0 1 7 7v14a7 7 0 0 1-7 7h-6l-5 8-5-8h-6a7 7 0 0 1-7-7v-14a7 7 0 0 1 7-7z" fill="url(#lm-brand)" />
            <rect x="-6" y="-27.5" width="12" height="12" rx="4" fill="#fff" />
          </g>
        </g>

        <!-- mobil Bloop -->
        <g class="car" data-car>
          <g class="car-body">
            <rect x="-11" y="-7" width="22" height="10" rx="4.5" fill="url(#lm-brand)" />
            <rect x="-5" y="-12" width="11" height="7" rx="3" fill="#fff" />
            <ellipse cx="-1.5" cy="-8.6" rx="1" ry="1.5" fill="#1b1830" />
            <ellipse cx="2.5" cy="-8.6" rx="1" ry="1.5" fill="#1b1830" />
            <circle cx="-6" cy="3.5" r="3" fill="#1b1830" /><circle cx="6" cy="3.5" r="3" fill="#1b1830" />
            <circle cx="-6" cy="3.5" r="1" fill="#fff" /><circle cx="6" cy="3.5" r="1" fill="#fff" />
          </g>
        </g>

        <!-- label kota -->
        <g class="lbl" data-lbl="jkt" transform="translate(300 128)">
          <rect x="-30" y="-9" width="60" height="18" rx="9" fill="#fff" />
          <text y="4" text-anchor="middle">Jakarta</text>
        </g>
        <g class="lbl" data-lbl="cbn" transform="translate(386 262)">
          <rect x="-36" y="-9" width="72" height="18" rx="9" fill="#1b1830" />
          <text class="lbl-dark" y="4" text-anchor="middle">Cibinong</text>
        </g>
        <g class="lbl" data-lbl="bgr" transform="translate(200 333)">
          <rect x="-24" y="-9" width="48" height="18" rx="9" fill="#fff" />
          <text y="4" text-anchor="middle">Bogor</text>
        </g>
      </g>
    </svg>
  </a>

  <div class="loc-card" data-card>
    <p class="loc-here"><span class="loc-sq" aria-hidden="true"></span>{copy.here}</p>
    <p class="loc-city">{copy.city}</p>
    <p class="loc-region">{copy.region}</p>
    <p class="loc-time">{copy.zone}</p>
  </div>

  <div class="loc-actions">
    <a class="loc-btn" href={mapsUrl} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
      {copy.open}
    </a>
    <button class="loc-btn" type="button" data-replay>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" /></svg>
      {copy.replay}
    </button>
  </div>
</div>

<script>
  import { gsap } from "gsap";
  import { MotionPathPlugin } from "gsap/MotionPathPlugin";
  gsap.registerPlugin(MotionPathPlugin);

  document.querySelectorAll<HTMLElement>("[data-loc]").forEach((root) => {
    const card = root.querySelector<HTMLElement>("[data-card]")!;
    const route = root.querySelector<SVGPathElement>("[data-route]")!;
    const reveal = root.querySelector<SVGPathElement>("[data-route-reveal]")!;
    const car = root.querySelector<SVGGElement>("[data-car]")!;
    const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const q = (s: string) => [...root.querySelectorAll<SVGElement>(s)];

    const len = reveal.getTotalLength();
    const placeCarAtStart = () => gsap.set(car, { motionPath: { path: route, align: route, alignOrigin: [0.5, 0.7], autoRotate: true, start: 0, end: 0 } });

    const endState = () => {
      gsap.set(q("[data-island], [data-mt], [data-tree], [data-monas], [data-hq], [data-pin], [data-lbl]"), { clearProps: "all" });
      gsap.set(reveal, { strokeDasharray: len, strokeDashoffset: 0 });
      gsap.set(card, { opacity: 1, y: 0, scale: 1 });
      gsap.set(car, { motionPath: { path: route, align: route, alignOrigin: [0.5, 0.7], autoRotate: true, start: 1, end: 1 } });
      root.classList.add("landed");
    };
    if (calm) {
      endState();
      return;
    }

    let drive: gsap.core.Timeline | null = null;
    const startDriving = () => {
      drive?.kill();
      drive = gsap.timeline({ repeat: -1, repeatDelay: 1.2 });
      drive
        .set(car, { opacity: 0 })
        .add(placeCarAtStart)
        .to(car, { opacity: 1, duration: 0.25 })
        .to(car, {
          motionPath: { path: route, align: route, alignOrigin: [0.5, 0.7], autoRotate: true },
          duration: 2.4,
          ease: "power1.inOut",
        })
        .to(q("[data-hq]"), { scaleX: 1.12, scaleY: 0.9, transformOrigin: "50% 100%", duration: 0.12, yoyo: true, repeat: 1, ease: "power2.out" })
        .to(car, { opacity: 0, duration: 0.3 }, "+=0.4");
    };

    const build = () => {
      root.classList.remove("landed");
      drive?.kill();
      gsap.set(car, { opacity: 0 });
      const tl = gsap.timeline({
        onComplete: () => {
          root.classList.add("landed");
          startDriving();
        },
      });
      tl.set(q("[data-island]"), { y: 70, opacity: 0, transformOrigin: "50% 100%" })
        .set(q("[data-mt]"), { scaleY: 0, transformOrigin: "50% 100%" })
        .set(q("[data-tree]"), { scale: 0, transformOrigin: "50% 100%" })
        .set(q("[data-monas]"), { scaleY: 0, opacity: 0, transformOrigin: "50% 100%" })
        .set(q("[data-hq]"), { y: -160, opacity: 0 })
        .set(q("[data-pin]"), { scale: 0, transformOrigin: "50% 100%" })
        .set(q("[data-lbl]"), { scale: 0, opacity: 0, transformOrigin: "50% 50%" })
        .set(reveal, { strokeDasharray: len, strokeDashoffset: len })
        .set(card, { opacity: 0, y: 16, scale: 0.94 })
        // 1) pulau naik dari laut
        .to(q("[data-island]"), { y: 0, opacity: 1, duration: 0.9, ease: "back.out(1.6)" })
        // 2) gunung & pohon meletup, Monas tumbuh
        .to(q("[data-mt]"), { scaleY: 1, duration: 0.7, ease: "back.out(2.2)", stagger: 0.15 }, "-=0.35")
        .to(q("[data-tree]"), { scale: 1, duration: 0.5, ease: "back.out(3)", stagger: 0.05 }, "-=0.4")
        .to(q("[data-monas]"), { scaleY: 1, opacity: 1, duration: 0.6, ease: "back.out(2)" }, "-=0.35")
        .to(q('[data-lbl="jkt"]'), { scale: 1, opacity: 1, duration: 0.4, ease: "back.out(2.5)" }, "-=0.2")
        // 3) markas jatuh memantul di Cibinong
        .to(q("[data-hq]"), { y: 0, opacity: 1, duration: 0.9, ease: "bounce.out" }, "-=0.1")
        .to(q('[data-lbl="bgr"]'), { scale: 1, opacity: 1, duration: 0.4, ease: "back.out(2.5)" }, "-=0.5")
        // 4) jalan tergambar dari Jakarta
        .to(reveal, { strokeDashoffset: 0, duration: 1, ease: "power2.inOut" }, "-=0.2")
        // 5) pin, label Cibinong, kartu
        .to(q("[data-pin]"), { scale: 1, duration: 0.6, ease: "back.out(3)" }, "-=0.2")
        .to(q('[data-lbl="cbn"]'), { scale: 1, opacity: 1, duration: 0.45, ease: "back.out(2.5)" }, "-=0.35")
        .to(card, { opacity: 1, y: 0, scale: 1, duration: 0.6, ease: "back.out(2)" }, "-=0.3");
      return tl;
    };

    let tl: gsap.core.Timeline | null = null;
    const io = new IntersectionObserver(
      ([en]) => {
        if (en.isIntersecting && !tl) {
          tl = build();
          io.disconnect();
        }
      },
      { threshold: 0.4 },
    );
    io.observe(root);
    root.querySelector("[data-replay]")?.addEventListener("click", () => {
      tl?.kill();
      tl = build();
    });
  });
</script>

<style>
  .loc {
    position: relative;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: #cfe6ff;
    box-shadow: inset 0 0 0 1px var(--line);
    aspect-ratio: 3 / 2;
    min-height: 320px;
  }
  .loc-map {
    position: absolute;
    inset: 0;
    display: block;
    cursor: pointer;
  }
  .loc-map svg {
    width: 100%;
    height: 100%;
  }
  /* elemen SVG yang dianimasikan dengan CSS: pakai kotak dirinya sendiri sebagai titik putar */
  .loc :global(.sun-rays),
  .loc :global(.cloud),
  .loc :global(.boat),
  .loc :global(.tree),
  .loc :global(.flame),
  .loc :global(.puff),
  .loc :global(.pin),
  .loc :global(.ripples ellipse),
  .loc :global(.hq),
  .loc :global(.birds) {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* ---- gerak ambient ---- */
  .sun-rays {
    animation: spin 14s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .cloud {
    animation: drift 26s linear infinite;
  }
  .c1 { --y: 74px; animation-delay: -4s; }
  .c2 { --y: 112px; animation-duration: 34s; animation-delay: -20s; }
  .c3 { --y: 48px; animation-duration: 30s; animation-delay: -12s; }
  @keyframes drift {
    from { transform: translate(-60px, var(--y)); }
    to { transform: translate(660px, var(--y)); }
  }
  .birds {
    animation: fly 18s linear infinite;
  }
  @keyframes fly {
    0% { transform: translate(-40px, 140px); }
    50% { transform: translate(300px, 112px); }
    100% { transform: translate(640px, 130px); }
  }
  .wave {
    animation: wave 3s linear infinite;
  }
  .w2 {
    animation-duration: 4s;
    animation-direction: reverse;
  }
  .w3 {
    animation-duration: 5s;
  }
  @keyframes wave {
    to { transform: translateX(-60px); }
  }
  .boat {
    animation: bob 3.2s ease-in-out infinite;
  }
  @keyframes bob {
    0%, 100% { transform: translateY(0) rotate(-4deg); }
    50% { transform: translateY(-4px) rotate(4deg); }
  }
  .tree {
    transform-origin: 50% 100% !important;
    animation: sway 3.4s ease-in-out infinite;
  }
  .tree-in:nth-of-type(2n) .tree {
    animation-delay: -1.3s;
  }
  @keyframes sway {
    0%, 100% { transform: rotate(-3deg); }
    50% { transform: rotate(3deg); }
  }
  .flame {
    animation: flicker 0.9s ease-in-out infinite alternate;
  }
  @keyframes flicker {
    from { transform: scale(1, 1); }
    to { transform: scale(0.85, 1.15); }
  }
  /* asap cerobong = kotak-kotak kecil ala logo */
  .puff {
    opacity: 0;
  }
  .landed .puff {
    animation: puff 2.4s ease-out infinite;
  }
  .landed .p2 {
    animation-delay: 0.8s;
  }
  .landed .p3 {
    animation-delay: 1.6s;
  }
  @keyframes puff {
    0% { opacity: 0; transform: translate(0, 0) scale(0.4) rotate(0deg); }
    20% { opacity: 1; }
    100% { opacity: 0; transform: translate(10px, -34px) scale(1.4) rotate(90deg); }
  }
  .ripples ellipse {
    fill: none;
    stroke: var(--violet);
    stroke-width: 1.6;
    opacity: 0;
  }
  .landed .ripples ellipse {
    animation: ripple 2.4s ease-out infinite;
  }
  .landed .ripples ellipse:nth-child(2) {
    animation-delay: 1.2s;
  }
  @keyframes ripple {
    from { opacity: 0.8; transform: scale(0.5); }
    to { opacity: 0; transform: scale(2.4); }
  }
  .landed .pin {
    animation: pin-bob 2.2s ease-in-out infinite;
  }
  @keyframes pin-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }
  /* sorot peta: markas bergoyang, asap lebih ramai */
  .loc-map:hover .hq {
    animation: hq-wiggle 0.6s ease-in-out infinite;
  }
  .loc-map:hover .puff {
    animation-duration: 1.2s;
  }
  @keyframes hq-wiggle {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(-4deg); }
    75% { transform: rotate(4deg); }
