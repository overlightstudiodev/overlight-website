    border: clamp(3px, 1cqw, 6px) solid transparent;
    border-radius: 28%;
    background: linear-gradient(#eee9fb, #eee9fb) padding-box, var(--grad) border-box;
    box-shadow: 0 5px 0 rgb(75 46 136 / 0.12);
  }
  .run-small { left: 2%; width: 6%; }
  .run-tall { left: 51%; width: 8%; }
  .run-coin {
    position: absolute;
    left: 52.9%;
    bottom: 60%;
    width: 4.2%;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff2a8, #f5b700 70%);
    box-shadow: inset 0 0 0 2px rgb(255 255 255 / 0.55), 0 3px 0 #dca32b;
    animation: run-collect 6s linear infinite;
  }
  .run-coin i {
    width: 18%;
    height: 46%;
    border-radius: 999px;
    background: #d99800;
  }
  /* salinan berikutnya masuk setelah koin pertama terambil */
  .run-tile:last-child .run-coin { animation: none; }
  .run-ground {
    bottom: 0;
    height: 22%;
    background:
      linear-gradient(#b99aeb, #b99aeb) top / 100% 9% no-repeat,
      linear-gradient(#5d3caa, #5d3caa) 0 16% / 100% 5% no-repeat,
      repeating-linear-gradient(90deg, var(--violet) 0 48%, #8d63d3 48% 100%) 0 0 / 5% 100%;
  }
  .run-shadow {
    position: absolute;
    left: 19.5%;
    bottom: 20.5%;
    width: 13%;
    height: 3%;
    border-radius: 50%;
    background: rgb(58 35 109 / 0.22);
    animation: run-shadow 6s linear infinite;
    z-index: 1;
  }
  .run-jump {
    position: absolute;
    left: 20%;
    bottom: 23.5%;
    width: 12%;
    aspect-ratio: 1;
    transform-origin: 50% 100%;
    animation: run-jump 6s linear infinite;
    z-index: 2;
  }
  .run-bloop {
    position: absolute;
    inset: 0;
    border-radius: 42% 42% 32% 32%;
    background: linear-gradient(160deg, #8fd0f0, #7d55cc);
    box-shadow: inset -0.6cqw -0.7cqw 0 rgb(0 0 0 / 0.12);
    animation: run-bob 0.3s ease-in-out infinite;
  }
  .run-eye,
  .run-blush,
  .run-stride,
  .run-tucked,
  .run-stride i,
  .run-tucked i {
    position: absolute;
  }
  .run-eye {
    top: 28%;
    width: 20%;
    height: 28%;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: #fff;
  }
  .run-eye-l { left: 22%; }
  .run-eye-r { right: 22%; }
  .run-eye i {
    width: 52%;
    height: 46%;
    border-radius: 50%;
    background: #1b1830;
    transform: translate(15%, 10%);
  }
  .run-blush {
    top: 58%;
    width: 16%;
    height: 9%;
    border-radius: 50%;
    background: #ff9db5;
    opacity: 0.85;
  }
  .run-blush-l { left: 9%; }
  .run-blush-r { right: 9%; }
  .run-stride,
  .run-tucked {
    inset: 0;
    animation: run-stride 6s steps(1, end) infinite;
  }
  .run-tucked { opacity: 0; animation-name: run-tucked; }
  .run-stride i,
  .run-tucked i {
    bottom: -7%;
    width: 24%;
    height: 12%;
    border-radius: 999px;
    background: #5b3fb0;
  }
  .run-stride i:first-child,
  .run-tucked i:first-child { left: 19%; }
  .run-stride i:last-child,
  .run-tucked i:last-child { right: 19%; }
  .run-stride i { animation: run-foot 0.3s ease-in-out infinite; }
  .run-stride i:last-child { animation-delay: -0.15s; }
  .run-tucked i:first-child { transform: translateY(-45%) rotate(20deg); }
  .run-tucked i:last-child { transform: rotate(-18deg); }
  .run-plus {
    position: absolute;
    left: 31%;
    top: 23%;
    color: #9b6410;
    font-size: clamp(14px, 3.5cqw, 23px);
    font-weight: 900;
    opacity: 0;
    animation: run-plus 6s linear infinite;
  }
  .run-hud {
    position: absolute;
    left: 5%;
    top: 6%;
    display: flex;
    align-items: center;
    gap: 1.2em;
    padding: 0.65em 0.85em;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.8);
    font-size: clamp(10px, 2.3cqw, 15px);
    font-variant-numeric: tabular-nums;
  }
  .run-score,
  .run-coins { display: flex; align-items: center; gap: 0.45em; }
  .run-score > span:first-child {
    color: #62517f;
    font-size: clamp(8px, 1.8cqw, 12px);
    letter-spacing: 0.06em;
  }
  .run-coins { animation: run-counter 6s linear infinite; }
  .run-coins > i {
    width: 0.8em;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #f5c648;
    box-shadow: inset 0 0 0 2px #ffe8a0;
  }
  .run-number { display: inline-block; width: 3ch; height: 1em; overflow: hidden; }
  .run-coins .run-number { width: 2ch; }
  .run-reel {
    display: flex;
    flex-direction: column;
    animation: run-count 60s -4.68s steps(10, end) infinite;
  }
  .run-reel > span { flex: none; height: 1em; }
  .run-hearts {
    position: absolute;
    right: 5%;
    top: 7%;
    width: 14%;
    display: flex;
    gap: 10%;
  }
  .run-hearts svg { width: 26.66%; fill: #ef759a; }
  .run-caption {
    position: absolute;
    left: 5%;
    bottom: 6%;
    font-size: clamp(8px, 1.8cqw, 12px);
    color: #f1e9ff;
    letter-spacing: 0.15em;
  }
  @keyframes run-scroll {
    to { transform: translateX(-50%); }
  }
  /* rintangan di x=55% dan x=105%; Bloop di x=26% */
  @keyframes run-jump {
    0%, 13%, 46%, 63%, 96%, 100% { transform: translateY(0) scale(1); }
    14%, 64% { transform: translateY(0) scale(1.15, 0.85); }
    17%, 67% { transform: translateY(-25%) scale(0.86, 1.16); }
    20%, 38%, 70%, 88% { transform: translateY(-110%) scale(0.93, 1.08); }
    25%, 33%, 75%, 83% { transform: translateY(-160%) scale(0.98, 1.03); }
    29%, 79% { transform: translateY(-170%) scale(1.02, 1); }
    41%, 91% { transform: translateY(-25%) scale(0.9, 1.12); }
    43%, 93% { transform: translateY(0) scale(1.2, 0.8); }
  }
  @keyframes run-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3%); }
  }
  @keyframes run-foot {
    0%, 100% { transform: translate(12%, -15%) rotate(12deg); }
    50% { transform: translate(-12%, -50%) rotate(-15deg); }
  }
  @keyframes run-stride {
    0%, 42%, 92%, 100% { opacity: 1; }
    16%, 66% { opacity: 0; }
  }
  @keyframes run-tucked {
    0%, 42%, 92%, 100% { opacity: 0; }
    16%, 66% { opacity: 1; }
  }
  @keyframes run-shadow {
    0%, 13%, 46%, 63%, 96%, 100% { transform: scaleX(1); opacity: 1; }
    29%, 79% { transform: scaleX(0.45); opacity: 0.35; }
  }
  @keyframes run-collect {
    0%, 21.9% { opacity: 1; }
    22%, 100% { opacity: 0; }
  }
  @keyframes run-plus {
    0%, 21.9%, 39%, 100% { opacity: 0; transform: translateY(15%) scale(0.9); }
    23% { opacity: 1; transform: translateY(0) scale(1.12); }
    29% { opacity: 1; transform: translateY(-50%) scale(1); }
    37% { opacity: 0; transform: translateY(-100%) scale(1); }
  }
  @keyframes run-counter {
    0%, 21%, 29%, 100% { transform: scale(1); }
    23% { transform: scale(1.12); }
  }
  @keyframes run-count {
    to { transform: translateY(-90.90909%); }
  }

