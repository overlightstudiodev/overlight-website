  /* ---- art: motion lab; semua gerak mengikuti playhead 6 detik ---- */
  .art-motion {
    --md-dur: 6s;
    position: absolute;
    inset: 0;
    container-type: inline-size;
    background: radial-gradient(#a997c540 0.7px, transparent 0.8px) 0 0 / 4% 6.4%;
    color: var(--ink);
  }
  .md-heading {
    position: absolute;
    left: 6%;
    top: 7%;
    display: flex;
    align-items: center;
    gap: 0.6em;
    font-size: clamp(9px, 2cqw, 13px);
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .md-heading > i { width: 0.6em; height: 0.6em; border-radius: 50%; background: var(--violet); }
  .md-heading > span {
    margin-left: 1em;
    color: #79698e;
    font-size: clamp(7px, 1.5cqw, 10px);
    font-weight: 500;
    letter-spacing: 0;
  }
  .md-swatches {
    position: absolute;
    right: 6%;
    top: 6%;
    width: 22%;
    display: flex;
    gap: 5%;
  }
  .md-swatches i { width: 21.25%; aspect-ratio: 1.25; border-radius: 25%; }
  .md-swatches i:nth-child(1) { background: var(--cyan); }
  .md-swatches i:nth-child(2) { background: var(--blue); }
  .md-swatches i:nth-child(3) { background: var(--violet); }
  .md-swatches i:nth-child(4) { background: var(--purple); }
  .md-label {
    display: block;
    color: #79698e;
    font-size: clamp(7px, 1.7cqw, 11px);
    font-weight: 650;
    line-height: 1;
    letter-spacing: 0.06em;
  }
  .md-shape-label { position: absolute; left: 7%; top: 20%; }
  .md-shape-stage {
    position: absolute;
    left: 6%;
    top: 28%;
    width: 28%;
    height: 36%;
    display: grid;
    place-items: center;
  }
  .md-shape {
    width: 68%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: inset -1.5cqw -1.5cqw 0 rgb(255 255 255 / 0.2);
    animation: md-morph var(--md-dur) ease-in-out infinite;
  }
  .md-type { position: absolute; left: 39%; top: 20%; width: 27%; line-height: 1; }
  .md-aa {
    display: block;
    margin-top: 3%;
    font-size: clamp(30px, 10.5cqw, 68px);
    line-height: 1;
    font-weight: 250;
    letter-spacing: -0.06em;
    animation: md-type var(--md-dur) ease-in-out infinite;
  }
  .md-weight { display: block; margin-top: 2%; font-size: clamp(7px, 1.6cqw, 10px); line-height: 1; color: #79698e; }
  .md-bounce {
    position: absolute;
    left: 39%;
    top: 49%;
    width: 24%;
    height: 19%;
    border-bottom: 1px solid #c5b5d5;
  }
  .md-ball {
    position: absolute;
    left: 39%;
    bottom: 5%;
    width: 23%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 25%, #c28de5, var(--violet));
    transform-origin: 50% 100%;
    transform: scale(1.2, 0.8);
    animation: md-bounce var(--md-dur) linear infinite;
  }
  .md-shadow {
    position: absolute;
    left: 33%;
    bottom: 0;
    width: 35%;
    height: 10%;
    border-radius: 50%;
    background: #7d55cc30;
    animation: md-shadow var(--md-dur) ease-in-out infinite;
  }
  .md-graph {
    position: absolute;
    left: 71%;
    top: 20%;
    width: 23%;
    height: 44%;
    border: 1px solid #e0d5eb;
    border-radius: 8%;
    background: rgb(255 255 255 / 0.65);
  }
  .md-graph .md-label { position: absolute; left: 9%; top: 10%; }
  .md-graph svg { position: absolute; left: 5%; top: 23%; width: 90%; height: 72%; }
  .md-axes { stroke: #dacfe6; stroke-width: 1; }
  .md-handle { stroke: #c2a9df; stroke-width: 1.5; stroke-dasharray: 3 4; }
  .md-bezier { stroke: var(--violet); stroke-width: 3; stroke-linecap: round; }
  /* lintasan CSS dalam satuan SVG: ikut skala viewBox dan aturan jeda panel */
  .md-dot {
    fill: var(--purple);
    stroke: #fff;
    stroke-width: 2;
    offset-path: path("M16 126C90 126 50 24 144 24");
    offset-distance: 0%;
    offset-rotate: 0deg;
    animation: md-ease var(--md-dur) linear infinite;
  }
  .md-timeline {
    position: absolute;
    left: 5%;
    top: 71%;
    width: 90%;
    height: 24%;
    border-radius: 2cqw;
    background: #262139;
    box-shadow: 0 1cqw 2cqw -1.5cqw #34234470;
    color: #eae2f8;
  }
  .md-timeline-heading {
    position: absolute;
    left: 4%;
    right: 5%;
    top: 10%;
    display: flex;
    justify-content: space-between;
    color: #b9afcd;
    font-size: clamp(6px, 1.45cqw, 9px);
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1;
  }
  .md-layers { position: absolute; inset: 32% 0 9%; display: grid; grid-template-rows: repeat(3, 1fr); }
  .md-layer { position: relative; --layer-color: var(--cyan); }
  .md-layer:nth-child(2) { --layer-color: var(--blue); }
  .md-layer:nth-child(3) { --layer-color: #c38ae9; }
  .md-layer-name {
    position: absolute;
    left: 4%;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    gap: 0.6em;
    font-size: clamp(7px, 1.6cqw, 10px);
    line-height: 1;
  }
  .md-layer-name i { width: 0.5em; height: 0.5em; border-radius: 20%; background: var(--layer-color); }
  .md-track { position: absolute; left: 30%; right: 6%; top: 20%; height: 60%; background: #ffffff09; border-radius: 2px; }
  .md-key {
    position: absolute;
    top: 50%;
    width: 2.2%;
    aspect-ratio: 1;
    border-radius: 15%;
    transform: translate(-50%, -50%) rotate(45deg);
    background: var(--layer-color);
    opacity: 0.35;
    animation: md-key-start var(--md-dur) linear infinite;
  }
  .md-key-start { left: 0; opacity: 1; }
  .md-key-mid { left: 50%; animation-name: md-key-mid; }
  .md-key-end { left: 100%; animation-name: md-key-end; }
  .md-playfield { position: absolute; left: 30%; right: 6%; top: 29%; bottom: 7%; pointer-events: none; }
  .md-playhead { position: absolute; inset: 0; animation: md-playhead var(--md-dur) linear infinite; }
  .md-playhead i { position: absolute; left: 0; top: 0; width: 1px; height: 100%; background: #ff92b1; }
  .md-playhead i::before {
    content: "";
    position: absolute;
    top: -7%;
    left: 50%;
    width: 1.25cqw;
    aspect-ratio: 1;
    border-radius: 20%;
    background: #ff92b1;
    transform: translateX(-50%) rotate(45deg);
  }
  @keyframes md-morph {
    0% { border-radius: 50%; background: var(--cyan); transform: rotate(0deg) scale(0.94); }
    25% { border-radius: 24%; background: var(--blue); transform: rotate(90deg) scale(0.92); }
