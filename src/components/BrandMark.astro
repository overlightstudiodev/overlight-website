---
// Tulisan OVER (tebal) LIGHT (tipis) bergradasi, seperti logo asli. Dipakai di header.
interface Props {
  size?: number;
}
const { size = 30 } = Astro.props;
---

<span class="brand" style={`--s:${size}px`}>
  <span class="brand-word"><b>OVER</b><span>LIGHT</span></span>
</span>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
  }
  .brand-word {
    display: inline-flex;
    font-size: calc(var(--s) * 0.62);
    letter-spacing: 0.02em;
    line-height: 1;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .brand-word b {
    font-weight: 850;
  }
  .brand-word span {
    font-weight: 330;
    letter-spacing: 0.06em;
  }
</style>
