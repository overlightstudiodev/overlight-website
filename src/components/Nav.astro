---
import BrandMark from "./BrandMark.astro";
import { waLink } from "../consts";
import { getLang, href, swapLangPath, t } from "../i18n";

interface Props {
  /** Path bahasa lain, kalau berbeda dari pola standar (mis. artikel tanpa terjemahan). */
  altPath?: string;
}
const lang = getLang(Astro.url);
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const alt = Astro.props.altPath ?? swapLangPath(Astro.url);
const contact = waLink(lang);

const links = [
  { label: t(lang, "nav.work"), to: href(lang, "/#porto"), match: href(lang, "/") },
  { label: t(lang, "nav.software"), to: href(lang, "/software"), match: href(lang, "/software") },
  { label: t(lang, "nav.articles"), to: href(lang, "/articles"), match: href(lang, "/articles") },
  { label: t(lang, "nav.about"), to: href(lang, "/about"), match: href(lang, "/about") },
];
const home = href(lang, "/").replace(/\/$/, "") || "/";
const isActive = (m: string) => {
  const mm = m.replace(/\/$/, "") || "/";
  if (mm === home) return false;
  return path === mm || path.startsWith(mm + "/");
};
---

<header class="nav" data-nav>
  <!-- blur bertingkat (8 pita): konten yang lewat di belakang header makin buram ke atas -->
  <div class="nav-blur" aria-hidden="true">
    <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
  </div>
  <div class="wrap nav-inner">
    <a href={href(lang, "/")} class="nav-brand" aria-label="Overlight home">
      <BrandMark size={38} />
    </a>

    <nav class="nav-links glass" aria-label="Utama">
      <a href={href(lang, "/")} class:list={["nav-link", "nav-home", { active: path === home }]} aria-label={t(lang, "nav.home")}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3.5 10.5 12 4l8.5 6.5" />
          <path d="M5.5 9.5V19a1 1 0 0 0 1 1H10v-5h4v5h3.5a1 1 0 0 0 1-1V9.5" />
        </svg>
      </a>
      {
        links.map((l) => (
          <a href={l.to} class:list={["nav-link", { active: isActive(l.match) }]} aria-current={isActive(l.match) ? "page" : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="nav-end">
      <a href={contact} class="nav-cta glass" target="_blank" rel="noopener">
        <span class="nav-dot" aria-hidden="true"></span>
        {t(lang, "nav.cta")}
      </a>
      <a href={alt} class="lang glass" hreflang={lang === "id" ? "en" : "id"} aria-label={t(lang, "nav.switchLabel")}>
        <span class:list={{ on: lang === "id" }}>ID</span>
        <span class:list={{ on: lang === "en" }}>EN</span>
      </a>
      <button class="burger glass" type="button" aria-expanded="false" aria-controls="nav-sheet" aria-label={t(lang, "nav.menu")} data-burger>
        <i></i><i></i>
      </button>
    </div>
  </div>

  <div class="sheet" id="nav-sheet" data-sheet>
    {
      links.map((l, i) => (
        <a
          href={l.to}
          class:list={["sheet-link", { active: isActive(l.match) }]}
          style={`--i:${i}`}
          aria-current={isActive(l.match) ? "page" : undefined}
        >
          {l.label}
        </a>
      ))
    }
    <a href={contact} class="sheet-link sheet-cta" style={`--i:${links.length}`} target="_blank" rel="noopener">
      <span class="nav-dot" aria-hidden="true"></span>
      {t(lang, "nav.cta")}
    </a>
  </div>
</header>
<div class="nav-space" aria-hidden="true"></div>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const burger = document.querySelector<HTMLButtonElement>("[data-burger]");
  const setOpen = (open: boolean) => {
    nav?.classList.toggle("open", open);
    burger?.setAttribute("aria-expanded", String(open));
  };
  burger?.addEventListener("click", () => setOpen(!nav?.classList.contains("open")));
  document.querySelectorAll("[data-sheet] a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  addEventListener("keydown", (e) => e.key === "Escape" && setOpen(false));
</script>

<style>
  /* header fixed (bukan sticky) + ruang pengganti di bawahnya: backdrop-filter di dalam header
     sticky tidak dijalankan di sebagian Chrome; pola ini sama dengan pagii.id */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
  }
  .nav-space {
    height: 80px;
  }

  /* ---- blur bertingkat di belakang header ----
     8 lapis backdrop-filter, tiap lapis menutup satu "pita" (mask), makin ke atas makin buram.
     Selalu aktif (tanpa animasi opacity: opacity < 1 mematikan backdrop-filter di Chrome). */
  .nav-blur {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 120px;
    pointer-events: none;
  }
  .nav-blur i {
    position: absolute;
    inset: 0;
  }
  /* tanpa brightness: latar halaman sedikit ungu, brightness membuatnya jadi pita putih */
  .nav-blur i:nth-child(1) {
    backdrop-filter: blur(0.25px) saturate(1.25);
    -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 0%, #000 12.5%, #000 25%, rgba(0, 0, 0, 0) 37.5%);
    mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 0%, #000 12.5%, #000 25%, rgba(0, 0, 0, 0) 37.5%);
  }
  .nav-blur i:nth-child(2) {
    backdrop-filter: blur(0.6px) saturate(1.25);
    -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 12.5%, #000 25%, #000 37.5%, rgba(0, 0, 0, 0) 50%);
    mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 12.5%, #000 25%, #000 37.5%, rgba(0, 0, 0, 0) 50%);
  }
  .nav-blur i:nth-child(3) {
    backdrop-filter: blur(1.2px) saturate(1.25);
    -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 25%, #000 37.5%, #000 50%, rgba(0, 0, 0, 0) 62.5%);
    mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 25%, #000 37.5%, #000 50%, rgba(0, 0, 0, 0) 62.5%);
  }
  .nav-blur i:nth-child(4) {
    backdrop-filter: blur(2.4px) saturate(1.25);
    -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 37.5%, #000 50%, #000 62.5%, rgba(0, 0, 0, 0) 75%);
    mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 37.5%, #000 50%, #000 62.5%, rgba(0, 0, 0, 0) 75%);
  }
  .nav-blur i:nth-child(5) {
    backdrop-filter: blur(4.5px) saturate(1.25);
    -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 50%, #000 62.5%, #000 75%, rgba(0, 0, 0, 0) 87.5%);
    mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 50%, #000 62.5%, #000 75%, rgba(0, 0, 0, 0) 87.5%);
  }
  .nav-blur i:nth-child(6) {
    backdrop-filter: blur(7.5px) saturate(1.25);
    -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 62.5%, #000 75%, #000 87.5%, rgba(0, 0, 0, 0) 100%);
    mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 62.5%, #000 75%, #000 87.5%, rgba(0, 0, 0, 0) 100%);
  }
  .nav-blur i:nth-child(7) {
    backdrop-filter: blur(11px) saturate(1.25);
    -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 75%, #000 87.5%, #000 100%);
    mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 75%, #000 87.5%, #000 100%);
  }
  .nav-blur i:nth-child(8) {
    backdrop-filter: blur(16px) saturate(1.25);
    -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 85%, #000 95%, #000 100%);
    mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 85%, #000 95%, #000 100%);
  }

  .nav-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 80px;
  }
  .nav-brand {
    flex: none;
    border-radius: 10px;
  }

  /* ---- pill kaca ---- */
  .glass {
    border-radius: 18px;
    background: rgb(255 255 255 / 0.85);
    backdrop-filter: blur(18px) saturate(1.8);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.8),
      0 1px 2px rgb(27 24 48 / 0.06),
      0 10px 26px -14px rgb(76 52 160 / 0.32);
  }

  .nav-links {
    display: flex;
    overflow: hidden;
  }
  .nav-link {
    display: flex;
    align-items: center;
    height: 52px;
    padding: 0 18px;
    font-size: 15px;
    font-weight: 550;
    color: var(--ink-2);
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .nav-link + .nav-link {
    box-shadow: inset 1px 0 0 rgb(27 24 48 / 0.07);
  }
  .nav-link:hover {
    color: var(--ink);
    background: rgb(255 255 255 / 0.65);
  }
  .nav-link.active {
    color: var(--violet);
    font-weight: 700;
    background: rgb(125 85 204 / 0.09);
  }
  .nav-home {
    justify-content: center;
    width: 54px;
    padding: 0;
  }
  .nav-home svg {
    width: 20px;
    height: 20px;
    transition: transform 0.45s var(--boing);
  }
  .nav-home:hover svg {
    transform: translateY(-2px) scale(1.08);
  }

  .nav-end {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 52px;
    padding: 0 18px;
    font-size: 15px;
    font-weight: 650;
    color: var(--ink);
    transition: transform 0.4s var(--boing);
  }
  .nav-cta:hover {
    transform: translateY(-2px);
  }
  .nav-dot {
    position: relative;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 3px rgb(34 197 94 / 0.18);
  }
  .nav-dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #22c55e;
    animation: ping 2s ease-out infinite;
  }
  @keyframes ping {
    0% { transform: scale(1); opacity: 0.6; }
    80%, 100% { transform: scale(2.6); opacity: 0; }
  }

  .lang {
    display: inline-flex;
    align-items: center;
    height: 52px;
    padding: 0 7px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .lang span {
    padding: 7px 10px;
    border-radius: 12px;
    color: var(--muted);
    transition: background-color 0.25s ease, color 0.25s ease;
  }
  .lang span.on {
    background: var(--grad);
    color: #fff;
  }
  .lang:hover span:not(.on) {
    color: var(--ink);
  }

  .burger {
    display: none;
    width: 52px;
    height: 52px;
    border: 0;
    cursor: pointer;
    position: relative;
  }
  .burger i {
    position: absolute;
    left: 17px;
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 0.4s var(--boing), top 0.3s ease;
  }
  .burger i:first-child {
    top: 21px;
  }
  .burger i:last-child {
    top: 29px;
  }
  .open .burger i:first-child {
    top: 25px;
    transform: rotate(45deg);
  }
  .open .burger i:last-child {
    top: 25px;
    transform: rotate(-45deg);
  }
  .sheet {
    display: none;
  }

  @media (max-width: 1080px) {
    .nav-cta {
      display: none;
    }
  }
  @media (max-width: 820px) {
    .nav-inner {
      height: 72px;
    }
    .nav-space {
      height: 72px;
    }
    .nav-blur {
      height: 96px;
    }
    .nav-links {
      display: none;
    }
    .lang,
    .burger {
      height: 46px;
    }
    .burger {
      display: block;
      width: 46px;
    }
    .burger i {
      left: 14px;
    }
    .burger i:first-child {
      top: 18px;
    }
    .burger i:last-child {
      top: 26px;
    }
    .open .burger i:first-child,
    .open .burger i:last-child {
      top: 22px;
    }
    .sheet {
      display: grid;
      margin: 0 calc(var(--gutter) - 8px);
      /* tertutup: tanpa padding supaya tidak menambah tinggi header (dan tidak menghalangi klik) */
      padding: 0 8px;
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      border-radius: 22px;
      background: rgb(255 255 255 / 0.72);
      backdrop-filter: blur(22px) saturate(1.9);
      box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.8), 0 18px 40px -20px rgb(76 52 160 / 0.35);
      transition: max-height 0.45s ease, opacity 0.3s ease, padding 0.3s ease;
    }
    .open .sheet {
      max-height: 420px;
      padding: 6px 8px 8px;
      opacity: 1;
    }
    .sheet-link {
      display: flex;
      align-items: center;
      gap: 10px;
      min-height: 48px;
      padding: 0 14px;
      border-radius: 14px;
      font-size: 17px;
      font-weight: 600;
      color: var(--ink-2);
      transform: translateY(8px);
      opacity: 0;
      transition: transform 0.5s var(--boing), opacity 0.3s ease, background-color 0.2s ease;
      transition-delay: calc(var(--i) * 40ms);
    }
    /* garis tipis pemisah antar menu */
    .sheet-link:not(:first-child):not(.sheet-cta) {
      box-shadow: inset 0 1px 0 rgb(27 24 48 / 0.06);
    }
    .sheet-link.active {
      color: var(--violet);
      font-weight: 700;
      background: rgb(125 85 204 / 0.09);
      box-shadow: none;
    }
    .sheet-link.active + .sheet-link {
      box-shadow: none;
    }
    .sheet-cta {
      justify-content: center;
      margin-top: 6px;
      font-size: 15px;
      font-weight: 650;
      color: var(--ink);
      background: #fff;
      box-shadow: inset 0 0 0 1px var(--line), 0 6px 16px -10px rgb(76 52 160 / 0.35);
    }
    .open .sheet-link {
      transform: none;
      opacity: 1;
    }
  }
</style>
