---
/** Tombol kembali ke atas (kanan bawah): lingkaran gradasi berisi Bloop putih + tulisan di bawahnya. */
import { getLang, t } from "../i18n";
const lang = getLang(Astro.url);
---

<button class="totop" type="button" aria-label={t(lang, "totop")} data-totop>
  <span class="tt-circle" aria-hidden="true">
    <span class="tt-bloop">
      <span class="tt-tuft"></span>
      <span class="tt-body">
        <span class="tt-eye"></span><span class="tt-eye"></span>
        <span class="tt-blush"></span><span class="tt-blush"></span>
      </span>
    </span>
    <span class="tt-float f1"></span>
    <span class="tt-float f2"></span>
    <span class="tt-puff"><i></i><i></i><i></i></span>
  </span>
  <span class="tt-label" aria-hidden="true">{t(lang, "totop.label")}</span>
</button>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-totop]");
  const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (btn) {
    let ticking = false;
    const update = () => {
      ticking = false;
      btn.classList.toggle("show", scrollY > 480);
    };
    addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
    btn.addEventListener("click", () => {
      btn.classList.remove("launch");
      void btn.offsetWidth;
      btn.classList.add("launch");
      scrollTo({ top: 0, behavior: calm ? "auto" : "smooth" });
    });
  }
</script>

<style>
  .totop {
    position: fixed;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(14px, env(safe-area-inset-bottom));
    z-index: 60;
    display: grid;
    justify-items: center;
    gap: 6px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(18px) scale(0.6);
    transition: opacity 0.3s ease, transform 0.5s var(--boing), visibility 0s linear 0.3s;
    -webkit-tap-highlight-color: transparent;
  }
  /* selama intro logo diputar, tombol "Lewati" ada di pojok yang sama */
  :global(.intro-on) .totop {
    display: none;
  }
  .totop.show {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  /* lingkaran penuh bergradasi Overlight */
  .tt-circle {
    position: relative;
    display: grid;
    place-items: center;
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: var(--grad);
    box-shadow: inset 0 2px 0 rgb(255 255 255 / 0.35), 0 16px 30px -12px rgb(125 85 204 / 0.6);
    transition: transform 0.5s var(--boing), box-shadow 0.3s ease;
  }
  .totop:hover .tt-circle {
    transform: translateY(-3px) scale(1.06);
    box-shadow: inset 0 2px 0 rgb(255 255 255 / 0.35), 0 20px 36px -12px rgb(125 85 204 / 0.7);
  }
  .totop:active .tt-circle {
    transform: scale(0.94);
  }
  .totop:focus-visible {
    outline: none;
  }
  .totop:focus-visible .tt-circle {
    outline: 3px solid var(--blue);
    outline-offset: 3px;
  }

  /* tulisan di bawah lingkaran */
  .tt-label {
    padding: 3px 10px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.85);
    backdrop-filter: blur(10px);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.9), 0 6px 14px -8px rgb(76 52 160 / 0.4);
    color: var(--violet);
    font-size: 12px;
    font-weight: 750;
    white-space: nowrap;
  }

  /* ---- Bloop putih ---- */
  .tt-bloop {
    position: relative;
    width: 36px;
    height: 36px;
    animation: tt-bob 1.8s ease-in-out infinite;
  }
  .tt-body {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 31px;
    border-radius: 44% 44% 34% 34%;
    background: #fff;
    box-shadow: inset -3px -3px 0 rgb(125 85 204 / 0.18), 0 4px 8px -4px rgb(27 24 48 / 0.35);
    transform-origin: 50% 100%;
  }
  /* jambul berbentuk panah ke atas */
  .tt-tuft {
    position: absolute;
    left: 50%;
    top: -7px;
    width: 11px;
    height: 11px;
    border-left: 3px solid #fff;
    border-top: 3px solid #fff;
    border-radius: 2px 0 0 0;
    translate: -50% 0;
    rotate: 45deg;
    transform-origin: 50% 100%;
    animation: tt-tuft 1.8s ease-in-out infinite;
  }
  .tt-eye {
    position: absolute;
    top: 9px;
    width: 6px;
    height: 9px;
    border-radius: 999px;
    background: #1b1830;
    animation: tt-blink 3.6s infinite, tt-look 5s ease-in-out infinite;
  }
  .tt-eye:nth-of-type(1) { left: 9px; }
  .tt-eye:nth-of-type(2) { right: 9px; }
  .tt-blush {
    position: absolute;
    top: 19px;
    width: 6px;
    height: 3.5px;
    border-radius: 50%;
    background: #ff9db5;
  }
  .tt-blush:nth-of-type(3) { left: 4px; }
  .tt-blush:nth-of-type(4) { right: 4px; }

  /* panah putih kecil yang melayang naik */
  .tt-float {
    position: absolute;
    left: 50%;
    bottom: 12px;
    width: 7px;
    height: 7px;
    border-left: 2.4px solid rgb(255 255 255 / 0.9);
    border-top: 2.4px solid rgb(255 255 255 / 0.9);
    rotate: 45deg;
    opacity: 0;
    pointer-events: none;
    animation: tt-float 3s ease-out infinite;
  }
  .f1 { margin-left: -22px; }
  .f2 { margin-left: 16px; animation-delay: 1.5s; }

  .totop:hover .tt-bloop {
    animation: tt-jump 0.7s cubic-bezier(0.3, 0, 0.3, 1) infinite;
  }

  /* semburan kotak putih saat meluncur */
  .tt-puff {
    position: absolute;
    left: 50%;
    bottom: 10px;
    pointer-events: none;
  }
  .tt-puff i {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    border: 2px solid #fff;
    opacity: 0;
  }
  .totop.launch .tt-bloop {
    animation: tt-launch 0.9s cubic-bezier(0.5, 0, 0.2, 1);
  }
  .totop.launch .tt-puff i {
    animation: tt-puff 0.7s ease-out;
  }
  .totop.launch .tt-puff i:nth-child(1) { --dx: -14px; }
  .totop.launch .tt-puff i:nth-child(2) { --dx: 0px; animation-delay: 0.05s; }
  .totop.launch .tt-puff i:nth-child(3) { --dx: 14px; animation-delay: 0.1s; }

  @keyframes tt-bob {
    0%, 100% { transform: translateY(1px); }
    50% { transform: translateY(-3px); }
  }
  @keyframes tt-tuft {
    0%, 100% { rotate: 45deg; }
    50% { rotate: 35deg; }
  }
  @keyframes tt-blink {
    0%, 90%, 100% { scale: 1 1; }
    94% { scale: 1 0.12; }
  }
  @keyframes tt-look {
    0%, 30% { translate: 0 1px; }
    40%, 70% { translate: 0 -2px; }
    78%, 88% { translate: 1.5px -1px; }
    100% { translate: 0 1px; }
  }
  @keyframes tt-float {
    0% { opacity: 0; translate: 0 0; }
    15% { opacity: 1; }
    60%, 100% { opacity: 0; translate: 0 -30px; }
  }
  @keyframes tt-jump {
    0%, 100% { transform: translateY(1px) scale(1.12, 0.88); }
    40% { transform: translateY(-8px) scale(0.92, 1.1); }
    70% { transform: translateY(-2px) scale(1, 1); }
  }
  /* meluncur keluar ke atas, lalu muncul lagi dari bawah */
  @keyframes tt-launch {
    0% { transform: scale(1.15, 0.8); opacity: 1; }
    40% { transform: translateY(-56px) scale(0.85, 1.25); opacity: 0; }
    41% { transform: translateY(32px); opacity: 0; }
    100% { transform: none; opacity: 1; }
  }
  @keyframes tt-puff {
    0% { opacity: 1; transform: translate(-50%, 0) scale(0.6) rotate(0deg); }
    100% { opacity: 0; transform: translate(calc(-50% + var(--dx)), 18px) scale(1.2) rotate(90deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .totop,
    .totop * {
      transition: none;
      animation: none !important;
    }
  }
</style>
