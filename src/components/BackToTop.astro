---
/** Tombol kembali ke atas (kanan bawah). Muncul setelah digulir; cincin menunjukkan progres gulir. */
import { getLang, t } from "../i18n";
const lang = getLang(Astro.url);
---

<button class="totop" type="button" aria-label={t(lang, "totop")} title={t(lang, "totop")} data-totop>
  <svg class="totop-ring" viewBox="0 0 56 56" aria-hidden="true">
    <defs>
      <linearGradient id="totop-g" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#74bcde" />
        <stop offset="0.55" stop-color="#7d55cc" />
        <stop offset="1" stop-color="#a660d8" />
      </linearGradient>
    </defs>
    <circle class="totop-track" cx="28" cy="28" r="25" />
    <circle class="totop-bar" cx="28" cy="28" r="25" pathLength="100" data-totop-bar />
  </svg>
  <svg class="totop-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5M5.5 11.5 12 5l6.5 6.5" />
  </svg>
</button>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-totop]");
  const bar = document.querySelector<SVGCircleElement>("[data-totop-bar]");
  const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (btn && bar) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const max = document.documentElement.scrollHeight - innerHeight;
      const p = max > 0 ? Math.min(1, scrollY / max) : 0;
      bar.style.strokeDashoffset = String(100 - p * 100);
      btn.classList.toggle("show", scrollY > 480);
    };
    addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    addEventListener("resize", update, { passive: true });
    update();
    btn.addEventListener("click", () => {
      btn.classList.remove("launch");
      void btn.offsetWidth;
      btn.classList.add("launch");
      scrollTo({ top: 0, behavior: calm ? "auto" : "smooth" });
    });
  }
</script>

<style>
  .totop {
    position: fixed;
    right: max(18px, env(safe-area-inset-right));
    bottom: max(18px, env(safe-area-inset-bottom));
    z-index: 60;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.85);
    backdrop-filter: blur(14px) saturate(1.6);
    -webkit-backdrop-filter: blur(14px) saturate(1.6);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.9), 0 14px 30px -14px rgb(76 52 160 / 0.45);
    color: var(--violet);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(18px) scale(0.6);
    transition: opacity 0.3s ease, transform 0.5s var(--boing), visibility 0s linear 0.3s;
    -webkit-tap-highlight-color: transparent;
  }
  /* selama intro logo diputar, tombol "Lewati" ada di pojok yang sama */
  :global(.intro-on) .totop {
    display: none;
  }
  .totop.show {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  .totop:hover {
    transform: translateY(-3px) scale(1.06);
  }
  .totop:active {
    transform: scale(0.94);
  }
  .totop-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }
  .totop-track,
  .totop-bar {
    fill: none;
    stroke-width: 3;
  }
  .totop-track {
    stroke: rgb(125 85 204 / 0.12);
  }
  .totop-bar {
    stroke: url(#totop-g);
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }
  .totop-arrow {
    width: 22px;
    height: 22px;
    transition: transform 0.45s var(--boing);
  }
  .totop:hover .totop-arrow {
    animation: hop 0.8s var(--boing) infinite;
  }
  @keyframes hop {
    0%, 100% { transform: translateY(1px); }
    45% { transform: translateY(-4px); }
  }
  /* saat diklik: panah melesat ke atas lalu muncul lagi dari bawah */
  .totop.launch .totop-arrow {
    animation: launch 0.7s cubic-bezier(0.5, 0, 0.2, 1);
  }
  @keyframes launch {
    0% { transform: none; opacity: 1; }
    45% { transform: translateY(-26px); opacity: 0; }
    46% { transform: translateY(20px); opacity: 0; }
    100% { transform: none; opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .totop,
    .totop-arrow {
      transition: none;
      animation: none !important;
    }
  }
</style>
