---
import logo from "../assets/brand/overlight-logo.svg?raw";
import { SITE, gmailLink, waLink } from "../consts";
import { getLang, href, swapLangPath, t } from "../i18n";

interface Props {
  altPath?: string;
}
const lang = getLang(Astro.url);
const alt = Astro.props.altPath ?? swapLangPath(Astro.url);
const year = new Date().getFullYear();
// Logo asli utuh (simbol + OVER LIGHT + tagline), ID gradien dibuat unik.
const footLogo = logo.replaceAll("olg-", "olgf-").replace("<svg ", '<svg aria-hidden="true" ');
const socials = [
  { label: "Email", url: SITE.email ? gmailLink(lang) : "" },
  { label: "WhatsApp", url: SITE.whatsapp ? waLink(lang) : "" },
  { label: "Instagram", url: SITE.instagram },
  { label: "GitHub", url: SITE.github },
].filter((s) => s.url);
---

<footer class="foot">
  <div class="wrap foot-inner">
    <div class="foot-brand">
      <a href={href(lang, "/")} class="foot-logo" aria-label="Overlight, your creative partner" set:html={footLogo} />
      <a class="foot-where" href="https://www.google.com/maps/search/?api=1&query=Cibinong%2C%20Bogor%2C%20Indonesia" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
        {t(lang, "contact.where")}
      </a>
    </div>
    <nav class="foot-links" aria-label="Footer">
      <a href={href(lang, "/#porto")}>{t(lang, "nav.work")}</a>
      <a href={href(lang, "/software")}>{t(lang, "nav.software")}</a>
      <a href={href(lang, "/articles")}>{t(lang, "nav.articles")}</a>
      <a href={href(lang, "/about")}>{t(lang, "nav.about")}</a>
      {socials.map((s) => <a href={s.url} target="_blank" rel="noopener">{s.label}</a>)}
      <a href={alt} hreflang={lang === "id" ? "en" : "id"}>{lang === "id" ? "English" : "Bahasa Indonesia"}</a>
    </nav>
  </div>
  <div class="wrap foot-bottom">
    <span>© {year} {SITE.studio}. {t(lang, "foot.rights")}</span>
    <span class="foot-squares" aria-hidden="true"><i></i><i></i><i></i></span>
  </div>
</footer>

<style>
  .foot {
    margin-top: 40px;
    padding: 56px 0 28px;
    border-top: 1px solid var(--line);
  }
  .foot-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 32px;
  }
  .foot-logo {
    display: block;
    width: clamp(150px, 16vw, 190px);
    border-radius: 12px;
    transition: transform 0.5s var(--boing);
  }
  .foot-logo :global(svg) {
    width: 100%;
    height: auto;
  }
  .foot-logo:hover {
    transform: rotate(-3deg) scale(1.03);
  }
  .foot-where {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
    transition: color 0.2s ease;
  }
  .foot-where:hover {
    color: var(--violet);
  }
  .foot-where svg {
    width: 16px;
    height: 16px;
  }
  .foot-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(140px, auto));
    gap: 10px 40px;
    font-weight: 550;
    color: var(--ink-2);
  }
  .foot-links a {
    transition: color 0.2s ease;
  }
  .foot-links a:hover {
    color: var(--violet);
  }
  .foot-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: 48px;
    font-size: 14px;
    color: var(--muted);
  }
  .foot-squares {
    display: flex;
    gap: 6px;
  }
  .foot-squares i {
    width: 12px;
    height: 12px;
    border-radius: 4px;
    border: 2.5px solid var(--cyan);
    animation: hop 2.4s var(--boing) infinite;
  }
  .foot-squares i:nth-child(2) {
    border-color: var(--blue);
    animation-delay: 0.15s;
  }
  .foot-squares i:nth-child(3) {
    border-color: var(--purple);
    animation-delay: 0.3s;
  }
  @keyframes hop {
    0%,
    60%,
    100% {
      transform: none;
    }
    30% {
      transform: translateY(-6px) rotate(12deg);
    }
  }
</style>
