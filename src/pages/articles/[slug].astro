---
import type { GetStaticPaths } from "astro";
import ArticleDetail from "../../views/ArticleDetail.astro";
import { getArticles } from "../../lib/content";
import { entrySlug } from "../../i18n";

export const getStaticPaths = (async () => {
  const entries = await getArticles("id");
  return entries.map((entry) => ({ params: { slug: entrySlug(entry.id) }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
---

<ArticleDetail entry={entry} lang="id" />
