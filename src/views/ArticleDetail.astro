---
import { Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import { hasTranslation } from "../lib/content";
import { baseLinks, entrySlug, formatDate, href, t, type Lang } from "../i18n";

interface Props {
  entry: CollectionEntry<"articles">;
  lang: Lang;
}
const { entry, lang } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const other = lang === "id" ? "en" : "id";
const altPath = (await hasTranslation("articles", entry.id)) ? href(other, `/articles/${entrySlug(entry.id)}`) : href(other, "/articles");
const app = d.software ? (await getCollection("software")).find((s) => s.id === `${lang}/${d.software}`) : undefined;
const ac = app?.data.accent ?? "var(--violet)";
---

<Base title={d.title} description={d.description} altPath={altPath}>
  <article class="post" style={`--ac:${ac}`}>
    <div class="wrap post-wrap">
      <a href={href(lang, "/articles")} class="back" data-reveal><span aria-hidden="true">←</span> {t(lang, "art.back")}</a>
      <header class="post-head">
        <p class="post-meta" data-reveal>
          <time datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate, lang)}</time>
          {d.tags.map((tag) => <span class="chip">{tag}</span>)}
        </p>
        <h1 data-reveal style="--d:1">{d.title}</h1>
        <p class="lead" data-reveal style="--d:2">{d.description}</p>
      </header>

      <div class="prose" data-reveal style="--d:3">
        {entry.rendered?.html ? <Fragment set:html={baseLinks(entry.rendered.html)} /> : <Content />}
      </div>

      {
        app && (
          <a href={href(lang, `/software/${d.software}`)} class="related" style={`--bg:${app.data.color}`} data-reveal>
            <span class="related-icon">
              <Image src={app.data.icon} alt="" width={96} height={96} />
            </span>
            <span>
              <span class="related-k">{t(lang, "art.related")}</span>
              <strong>{app.data.title}</strong>
              <span class="related-t">{app.data.tagline}</span>
            </span>
            <span class="related-go" aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
  </article>
</Base>

<style>
  .post-wrap {
    max-width: 820px;
    padding-bottom: clamp(72px, 10vw, 128px);
  }
  .back {
    display: inline-flex;
    gap: 8px;
    margin-top: clamp(24px, 4vw, 40px);
    padding: 8px 14px 8px 10px;
    border-radius: 999px;
    font-weight: 600;
    color: var(--ink-2);
    transition: background-color 0.2s ease;
  }
  .back:hover {
    background: var(--tint);
  }
  .post-head {
    padding: clamp(24px, 4vw, 48px) 0 clamp(28px, 4vw, 44px);
    margin-bottom: clamp(28px, 4vw, 44px);
    border-bottom: 1px solid var(--line);
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    color: var(--muted);
    font-size: 15px;
  }
  .post-meta time::before {
    content: "";
    display: inline-block;
    width: 12px;
    height: 12px;
    margin-right: 10px;
    border-radius: 4px;
    border: 3px solid var(--ac);
    vertical-align: -1px;
  }
  .post h1 {
    margin: 18px 0 18px;
    font-size: clamp(38px, 6vw, 68px);
    letter-spacing: -0.03em;
  }
  .prose :global(ul > li::before) {
    border-color: var(--ac);
  }
  .related {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) auto;
    align-items: center;
    gap: 18px;
    margin-top: clamp(40px, 6vw, 64px);
    padding: 18px 22px 18px 18px;
    border-radius: var(--r-lg);
    background: var(--bg);
    transition: transform 0.5s var(--boing);
  }
  .related:hover {
    transform: translateY(-4px) rotate(-0.5deg);
  }
  .related-icon {
    width: 72px;
    height: 72px;
    border-radius: 21px;
    overflow: hidden;
  }
  .related-icon :global(img) {
    width: 100%;
    height: 100%;
  }
  .related > span:nth-child(2) {
    display: grid;
    gap: 2px;
  }
  .related-k {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ac);
  }
  .related strong {
    font-size: 22px;
  }
  .related-t {
    color: var(--ink-2);
  }
  .related-go {
    font-size: 24px;
    font-weight: 700;
    transition: transform 0.4s var(--boing);
  }
  .related:hover .related-go {
    transform: translateX(6px);
  }
</style>
