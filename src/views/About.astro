---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import logo from "../assets/brand/overlight-logo.svg?raw";
import { getArticles, getSoftware } from "../lib/content";
import { SITE } from "../consts";
import { type Lang, t } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const apps = await getSoftware(lang);
const platforms = new Set(apps.flatMap((a) => a.data.platforms));
const notes = (await getArticles(lang)).length;
const svg = logo.replaceAll("olg-", "olga-").replace("<svg ", '<svg class="about-logo" ');

const c = {
  id: {
    lead: "Overlight adalah studio kreatif kecil dari Indonesia. Kami percaya produk digital yang baik itu mudah dipakai, rapi dikerjakan, dan sedikit menyenangkan.",
    storyT: "Your creative partner",
    story: [
      "Kami bekerja seperti partner, bukan sekadar vendor. Ikut memikirkan masalahnya, merancang solusinya, membangun produknya, lalu terus merawat setelah rilis.",
      "Sebagian besar produk kami lahir dari kebutuhan sendiri: download manager yang enak di Mac, cara mudah mirror HP untuk streaming, atau mencatat makanan tanpa ribet. Kalau kami sendiri betah memakainya, biasanya orang lain juga.",
    ],
    stats: [
      { n: String(apps.length), l: "produk yang sudah kami bangun" },
      { n: String(platforms.size), l: "platform: Android, macOS, Windows" },
      { n: String(notes), l: "artikel dari dapur Overlight" },
    ],
    valuesT: "Cara kami bekerja",
    values: [
      { t: "Dipakai sendiri dulu", d: "Setiap fitur kami coba sendiri sebelum sampai ke tanganmu." },
      { t: "Sederhana itu kerja keras", d: "Kami memangkas langkah yang tidak perlu sampai yang tersisa terasa jelas." },
      { t: "Main-main itu serius", d: "Sedikit gerakan dan kejutan kecil membuat produk terasa hidup." },
    ],
    stepsT: "Dari ide sampai rilis",
    steps: [
      { t: "Ngobrol", d: "Kita bahas masalah, pengguna, dan apa arti berhasil buatmu." },
      { t: "Rancang", d: "Sketsa, alur, dan desain yang bisa kamu klik sebelum ada kode." },
      { t: "Bangun", d: "Kami kembangkan dalam putaran pendek supaya kamu selalu bisa mencoba." },
      { t: "Rawat", d: "Setelah rilis, kami pantau, perbaiki, dan tambah fitur bersama." },
    ],
    contactT: "Ayo ngobrol",
    contactD: "Punya ide aplikasi, game, atau butuh bantuan desain? Ceritakan saja.",
    contactNone: "Kontak email akan segera kami tambahkan di sini.",
  },
  en: {
    lead: "Overlight is a small creative studio from Indonesia. We believe good digital products are easy to use, carefully made, and a little bit fun.",
    storyT: "Your creative partner",
    story: [
      "We work like a partner, not just a vendor. We think through the problem with you, design the solution, build the product, and keep looking after it after launch.",
      "Most of our products started from our own needs: a download manager that feels good on the Mac, an easy way to mirror a phone for streaming, or logging food without the hassle. If we enjoy using it ourselves, other people usually do too.",
    ],
    stats: [
      { n: String(apps.length), l: "products we have built" },
      { n: String(platforms.size), l: "platforms: Android, macOS, Windows" },
      { n: String(notes), l: "articles from the Overlight kitchen" },
    ],
    valuesT: "How we work",
    values: [
      { t: "Use it ourselves first", d: "We try every feature ourselves before it reaches you." },
      { t: "Simple is hard work", d: "We cut unnecessary steps until what is left feels obvious." },
      { t: "Play is serious", d: "A bit of motion and a few small surprises make a product feel alive." },
    ],
    stepsT: "From idea to launch",
    steps: [
      { t: "Talk", d: "We discuss the problem, the users, and what success means to you." },
      { t: "Design", d: "Sketches, flows, and a clickable design before any code." },
      { t: "Build", d: "We develop in short rounds so you can always try it out." },
      { t: "Care", d: "After launch, we monitor, fix, and add features together." },
    ],
    contactT: "Let's talk",
    contactD: "Have an idea for an app or a game, or need help with design? Tell us about it.",
    contactNone: "A contact email will be added here soon.",
  },
}[lang];
---

<Base title={t(lang, "about.title")} description={c.lead}>
  <PageHead eyebrow="Overlight Studio" title={t(lang, "about.title")} lead={c.lead} />

  <section class="wrap story">
    <div class="story-logo" data-reveal set:html={svg} />
    <div class="story-copy">
      <h2 data-reveal>{c.storyT}</h2>
      {c.story.map((p, i) => <p data-reveal style={`--d:${i + 1}`}>{p}</p>)}
    </div>
  </section>

  <section class="wrap stats">
    {
      c.stats.map((s, i) => (
        <div class="stat" data-reveal style={`--d:${i}`}>
          <span class="stat-n grad-text">{s.n}</span>
          <span class="stat-l">{s.l}</span>
        </div>
      ))
    }
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head" data-reveal><h2>{c.valuesT}</h2></div>
      <div class="values">
        {
          c.values.map((v, i) => (
            <div class="value" data-reveal style={`--d:${i}`}>
              <span class="value-sq" aria-hidden="true" />
              <h3>{v.t}</h3>
              <p>{v.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section steps-wrap">
    <div class="wrap">
      <div class="section-head" data-reveal><h2>{c.stepsT}</h2></div>
      <ol class="steps">
        {
          c.steps.map((s, i) => (
            <li data-reveal style={`--d:${i}`}>
              <span class="step-n">{String(i + 1).padStart(2, "0")}</span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="kontak">
    <div class="wrap">
      <div class="contact" data-reveal>
        <h2>{c.contactT}</h2>
        <p class="lead">{c.contactD}</p>
        {
          SITE.email ? (
            <a class="btn btn-grad" href={`mailto:${SITE.email}`}>
              {SITE.email}
            </a>
          ) : (
            <p class="contact-none">{c.contactNone}</p>
          )
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .story {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
    padding-bottom: clamp(48px, 7vw, 96px);
  }
  .story-logo {
    max-width: 440px;
    width: 100%;
    justify-self: center;
  }
  .story-logo :global(svg) {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .story-logo :global(.ol-s1),
  .story-logo :global(.ol-s2),
  .story-logo :global(.ol-s3) {
    transform-box: fill-box;
    transform-origin: center;
    animation: hop 3.6s var(--boing) infinite;
  }
  .story-logo :global(.ol-s2) {
    animation-delay: 0.18s;
  }
  .story-logo :global(.ol-s3) {
    animation-delay: 0.36s;
  }
  @keyframes hop {
    0%,
    55%,
    100% {
      transform: none;
    }
    25% {
      transform: translateY(-36px) rotate(10deg);
    }
  }
  .story-copy h2 {
    font-size: clamp(34px, 4.6vw, 56px);
    margin-bottom: 24px;
  }
  .story-copy p {
    font-size: 19px;
    color: var(--ink-2);
    max-width: 52ch;
  }
  .story-copy p + p {
    margin-top: 16px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .stat {
    display: grid;
    gap: 6px;
    padding: 28px;
    border-radius: var(--r-lg);
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .stat-n {
    font-size: clamp(64px, 8vw, 104px);
    font-weight: 850;
    line-height: 1;
    letter-spacing: -0.04em;
    justify-self: start;
  }
  .stat-l {
    color: var(--ink-2);
  }

  .values {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 1.8vw, 22px);
  }
  .value {
    padding: 30px;
    border-radius: var(--r-lg);
    background: var(--tint);
  }
  .value-sq {
    display: block;
    width: 34px;
    height: 34px;
    border-radius: 11px;
    border: 7px solid var(--blue);
    transition: transform 0.6s var(--boing);
  }
  .value:nth-child(1) .value-sq {
    border-color: var(--cyan);
  }
  .value:nth-child(3) .value-sq {
    border-color: var(--purple);
  }
  .value:hover .value-sq {
    transform: rotate(90deg) scale(1.15);
  }
  .value h3 {
    margin: 22px 0 10px;
    font-size: 26px;
  }
  .value p {
    color: var(--ink-2);
  }

  .steps-wrap {
    padding-top: 0;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }
  .steps li {
    position: relative;
    padding: 26px 24px;
    border-radius: var(--r);
    box-shadow: inset 0 0 0 1px var(--line-2);
  }
  .step-n {
    font-size: 14px;
    font-weight: 800;
    color: var(--violet);
  }
  .steps h3 {
    margin: 10px 0 8px;
    font-size: 24px;
  }
  .steps p {
    color: var(--ink-2);
    font-size: 16px;
  }

  .contact {
    padding: clamp(36px, 6vw, 72px);
    border-radius: clamp(36px, 5vw, 64px);
    border: clamp(10px, 1.4vw, 16px) solid transparent;
    background: linear-gradient(var(--paper), var(--paper)) padding-box, var(--grad) border-box;
    text-align: center;
  }
  .contact h2 {
    font-size: clamp(36px, 5.4vw, 64px);
    margin-bottom: 16px;
  }
  .contact .lead {
    margin: 0 auto 28px;
  }
  .contact-none {
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .story,
    .values {
      grid-template-columns: 1fr;
    }
    .story-logo {
      max-width: 300px;
    }
    .stats {
      grid-template-columns: 1fr;
    }
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
