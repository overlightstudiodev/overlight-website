---
import Base from "../layouts/Base.astro";
import { href, t, type Lang } from "../i18n";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Base title={t(lang, "notfound.t")} altPath={href(lang === "id" ? "en" : "id", "/")}>
  <section class="wrap nf">
    <div class="nf-sq" aria-hidden="true"><i></i><i></i><i></i></div>
    <h1>404</h1>
    <h2>{t(lang, "notfound.t")}</h2>
    <p class="lead">{t(lang, "notfound.d")}</p>
    <a class="btn" href={href(lang, "/")}>{t(lang, "notfound.btn")}</a>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    justify-items: center;
    gap: 16px;
    padding-top: clamp(60px, 10vw, 140px);
    padding-bottom: clamp(60px, 10vw, 140px);
    text-align: center;
  }
  .nf h1 {
    font-size: clamp(96px, 18vw, 200px);
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    letter-spacing: -0.05em;
  }
  .nf h2 {
    font-size: clamp(26px, 4vw, 40px);
  }
  .nf .lead {
    margin-bottom: 16px;
  }
  .nf-sq {
    display: flex;
    gap: 10px;
  }
  .nf-sq i {
    width: 26px;
    height: 26px;
    border-radius: 8px;
    border: 5px solid var(--cyan);
    animation: tumble 2.2s var(--boing) infinite;
  }
  .nf-sq i:nth-child(2) {
    border-color: var(--blue);
    animation-delay: 0.15s;
  }
  .nf-sq i:nth-child(3) {
    border-color: var(--purple);
    animation-delay: 0.3s;
  }
  @keyframes tumble {
    0%,
    60%,
    100% {
      transform: none;
    }
    30% {
      transform: translateY(-18px) rotate(90deg);
    }
  }
</style>
