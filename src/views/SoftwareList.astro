---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import { getSoftware } from "../lib/content";
import { PLATFORM_LABEL, entrySlug, href, t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const apps = (await getSoftware(lang)).filter((a) => a.data.free);
---

<Base title={t(lang, "sw.title")} description={t(lang, "sw.lead")}>
  <PageHead eyebrow="Overlight" title={t(lang, "sw.title")} lead={t(lang, "sw.lead")} />

  <section class="wrap list-wrap">
    <ol class="list">
      {
        apps.map((a, i) => (
          <li data-reveal style={`--d:${i}`}>
            <a href={href(lang, `/software/${entrySlug(a.id)}`)} class="row" style={`--bg:${a.data.color};--ac:${a.data.accent}`}>
              <span class="row-num">{String(i + 1).padStart(2, "0")}</span>
              <span class="row-icon">
                <Image src={a.data.icon} alt="" width={112} height={112} />
              </span>
              <span class="row-main">
                <span class="row-title">
                  <h2>{a.data.title}</h2>
                  <span class:list={["chip", `chip-${a.data.status}`]}>{t(lang, `status.${a.data.status}` as const)}</span>
                </span>
                <span class="row-tag">{a.data.tagline}</span>
              </span>
              <span class="row-meta">
                <span class="chips">
                  {a.data.platforms.map((p) => (
                    <span class="chip">{PLATFORM_LABEL[p]}</span>
                  ))}
                  <span class="chip">{a.data.price ?? t(lang, "sw.free")}</span>
                </span>
              </span>
              <span class="row-go" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .list-wrap {
    padding-bottom: clamp(72px, 10vw, 128px);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 44px 84px minmax(0, 1fr) auto 52px;
    align-items: center;
    gap: 22px;
    padding: 20px 22px;
    border-radius: var(--r-lg);
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--line);
    overflow: hidden;
    isolation: isolate;
    transition: transform 0.5s var(--boing), box-shadow 0.3s ease;
  }
  .row::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--bg);
    clip-path: circle(0% at 110px 50%);
    transition: clip-path 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .row:hover {
    transform: translateX(6px);
    box-shadow: inset 0 0 0 1px transparent, var(--shadow);
  }
  .row:hover::before {
    clip-path: circle(150% at 110px 50%);
  }
  .row-num {
    font-size: 15px;
    font-weight: 700;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .row-icon {
    width: 84px;
    height: 84px;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 10px 24px -14px rgb(0 0 0 / 0.45);
    transition: transform 0.55s var(--boing);
  }
  .row-icon :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .row:hover .row-icon {
    transform: rotate(-10deg) scale(1.06);
  }
  .row-main {
    display: grid;
    gap: 6px;
    min-width: 0;
  }
  .row-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
  }
  .row h2 {
    font-size: clamp(26px, 3vw, 36px);
  }
  .row-tag {
    color: var(--ink-2);
  }
  .row-meta .chips {
    justify-content: flex-end;
    max-width: 260px;
  }
  .row-go {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 18px;
    background: var(--ink);
    color: #fff;
    transition: transform 0.45s var(--boing), background-color 0.25s ease;
  }
  .row-go svg {
    width: 22px;
    height: 22px;
  }
  .row:hover .row-go {
    background: var(--ac);
    transform: scale(1.08);
  }

  @media (max-width: 900px) {
    .row {
      grid-template-columns: 64px minmax(0, 1fr) 44px;
      gap: 16px;
      padding: 18px;
    }
    .row-num,
    .row-meta {
      display: none;
    }
    .row-icon {
      width: 64px;
      height: 64px;
      border-radius: 19px;
    }
    .row-go {
      width: 44px;
      height: 44px;
      border-radius: 14px;
    }
    .row::before {
      clip-path: circle(0% at 50px 50%);
    }
    .row:hover::before {
      clip-path: circle(150% at 50px 50%);
    }
  }
</style>
